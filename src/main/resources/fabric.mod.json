{
  "schemaVersion": 1,
  "id": "smartmendcraft",
  "version": "${version}",
  "name": "Smart Mend Craft",
  "description": "Improves the Mending enchantment with configurable repair priorities, inventory repair modes and visual repair notifications.",
  "authors": [
    "Radig"
  ],
  "contact": {
    "sources": "https://github.com/Plap99/SmartMendCraft"
  },
  "license": "ARR",
  "icon": "assets/smartmendcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.radig.smartmendcraft.SmartMendCraft"
    ],
    "client": [
      "com.radig.smartmendcraft.client.SmartMendCraftClient"
    ]
  },
  "mixins": [
    "smartmendcraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}